func_genes <- read_excel(
path = paste0(wk, "Deconv_SupplementaryTables.xlsx"),
sheet = "S8",
skip = 1   # equivalent to header=1 in pandas
)
# --- clean p-values ---
func_genes <- func_genes %>%
mutate(
TCGA_pvalue_clean  = as.numeric(replace(TCGA_pvalue,  TCGA_pvalue  == "<1E-12", 1e-12)),
CPTAC_pvalue_clean = as.numeric(replace(CPTAC_pvalue, CPTAC_pvalue == "<1E-12", 1e-12))
)
cap_p <- 1e-15
vol_plot(func_genes, dataset = "CPTAC", wk = wk)
vol_plot(func_genes, dataset = "TCGA", wk = wk)
# --- read data ---
depmap_res <- read_csv(paste0(wk, "DepMap_scores_Colorectal Adenocarcinoma.csv"), skip = 1)
func_genes <- read_excel(paste0(wk, "Deconv_SupplementaryTables.xlsx"),sheet = "S8",skip = 1)
# --- select top 28 genes ---
selected_top28_genes <- func_genes %>%
select(genename, DepMap_Median) %>%
distinct() %>%
arrange(DepMap_Median) %>%
slice_head(n = 28)
gene_order <- selected_top28_genes$genename
# --- filter + order ---
df <- depmap_res %>%
filter(Genes %in% gene_order) %>%
mutate(Genes = factor(Genes, levels = gene_order)) %>%
arrange(Genes)
# --- reshape (wide → long) ---
df_long <- df %>%
pivot_longer(
cols = -Genes,
names_to = "Sample",
values_to = "Score"
)
# --- plot ---
p <- ggplot(df_long, aes(x = Genes, y = Score)) +
geom_boxplot(
fill = NA,                 # 👈 empty box
color = "black",
linewidth = 0.5,
outlier.size = 0.5
) +
# threshold line
geom_hline(
yintercept = -0.5,
color = "red",
linetype = "dashed",
linewidth = 0.5
) +
labs(
x = NULL,
y = "DepMap CERES scores"
) +
theme_classic() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
panel.border = element_rect(color = "black", fill = NA, linewidth = 0.8)
)
# --- save ---
ggsave(
filename = file.path(wk, "Figures_raw/DepMap_top28.pdf"),
plot = p,
width = 6,
height = 6,
dpi = 300
)
library(dplyr)
library(readr)
library(readxl)
library(tidyr)
library(ggplot2)
library(ggrepel)
## cPTAC plot
vol_plot <- function(df, dataset = c("CPTAC", "TCGA"), cap_p = 1e-15, wk) {
dataset <- match.arg(dataset)
# --- dynamic column names ---
p_col <- paste0(dataset, "_pvalue_clean")
support_col <- paste0(dataset, "_support")
dir_col <- if (dataset == "CPTAC") {
"CPTAC_Direction(+: if higher expressoin in tumor vs normal; -: if lower expressoin in tumor vs normal)"
} else {
"TCGA_Direction(+: if higher expressoin in tumor vs normal; -: if lower expressoin in tumor vs normal)"
}
# --- 1. Filter ---
df2 <- df %>%filter(!is.na(.data[[p_col]]))
# --- 2. Clean P ---
df2 <- df2 %>%mutate(!!p_col := pmax(.data[[p_col]], cap_p))
# --- 3. Z-score ---
df2 <- df2 %>%mutate(z = qnorm(1 - .data[[p_col]] / 2))
# --- 4. Signed effect ---
df2 <- df2 %>%mutate(
sign = case_when(
.data[[dir_col]] == "+" ~ 1,
.data[[dir_col]] == "-" ~ -1,
TRUE ~ 0
),
stats = sign * z
)
# --- 5. Keep consistent direction ---
df2 <- df2 %>%filter(
(`Suggest Function` == "tumor onco gene" & stats > 0) |
(`Suggest Function` == "tumor suppressor gene" & stats < 0)
)
# --- 6. Deduplicate ---
df2 <- df2 %>%arrange(.data[[p_col]], genename) %>%
distinct(genename, .keep_all = TRUE) %>%
select(genename, stats, !!p_col, !!support_col)
# --- 7. Color + y ---
df2 <- df2 %>%mutate(
color = case_when(
stats > 0 & .data[[support_col]] == paste(dataset, "oncogenic support") ~ "red",
stats < 0 & .data[[support_col]] == paste(dataset, "suppressor support") ~ "blue",
TRUE ~ "grey"
),y = -log10(.data[[p_col]]))
# --- 8. Labels ---
df_label <- df2 %>%filter(!is.na(.data[[support_col]]))
# --- 9. Plot ---
p <- ggplot(df2, aes(x = stats, y = y)) +
geom_hline(yintercept = -log10(0.05),linetype = "dashed", color = "black", alpha = 0.5, linewidth = 0.5) +
geom_vline(xintercept = 0, color = "black") +
geom_point(aes(color = color), alpha = 0.8, size = 2) +
scale_color_identity() +
geom_text_repel(
data = df_label,
aes(label = genename),
size = 2,
max.overlaps = 150,
force = 1,
box.padding = 0.5,
point.padding = 0.3,
segment.color = "grey",   # 👈 line color
segment.alpha = 0.5,      # 👈 transparency
segment.size = 0.3        # 👈 line width
) +
scale_y_continuous(limits = c(0, 15),breaks = seq(0, 15, by = 1)) +
labs(
#title = paste("CRC risk genes (", dataset, ")", sep = ""),
x = paste0("Approximate Z score (",dataset,")"),
y = "-log10(p-value)"
) +
theme_classic() +
theme(panel.border = element_rect(color = "black", fill = NA, linewidth = 0.8))
# --- 10. Save ---
ggsave(
filename = file.path(wk, "Figures_raw/", paste0(dataset, "_volcano.pdf")),
plot = p,
width = 8,
height = 6,
dpi = 300
)
return(p)
}
##### Main #####
